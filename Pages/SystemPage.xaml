<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="SettingsClone.Pages.SystemPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{StaticResource SettingsTextBrush}">
    <ScrollViewer x:Name="SystemScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <Grid Width="{Binding ViewportWidth, ElementName=SystemScrollViewer}">
            <StackPanel MaxWidth="1000" Margin="24,6,24,32" Spacing="8">
                <TextBlock Text="System" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,16" AutomationProperties.AutomationId="SystemHeading" />
                <TextBlock Text="Demo settings for HW1012. These controls do not change Windows settings." Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,16" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Button Tag="Display" Style="{StaticResource SettingsRowButtonStyle}" Click="SystemSetting_Click">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7F4;" FontSize="20" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Display" FontWeight="SemiBold" />
                                <TextBlock Text="Monitors, brightness, and scaling" Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" />
                        </Grid>
                    </Button>
                </Border>
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Button Tag="Sound" Style="{StaticResource SettingsRowButtonStyle}" Click="SystemSetting_Click">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE767;" FontSize="20" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Sound" FontWeight="SemiBold" />
                                <TextBlock Text="Volume, output, and input devices" Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" />
                        </Grid>
                    </Button>
                </Border>
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Button Tag="Notifications" Style="{StaticResource SettingsRowButtonStyle}" Click="SystemSetting_Click">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7E7;" FontSize="20" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Notifications" FontWeight="SemiBold" />
                                <TextBlock Text="Alerts from apps and the system" Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" />
                        </Grid>
                    </Button>
                </Border>
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Button Tag="Power &amp; battery" Style="{StaticResource SettingsRowButtonStyle}" Click="SystemSetting_Click">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE83E;" FontSize="20" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Power &amp; battery" FontWeight="SemiBold" />
                                <TextBlock Text="Sleep, power mode, and battery usage" Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" />
                        </Grid>
                    </Button>
                </Border>
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Button Tag="Storage" Style="{StaticResource SettingsRowButtonStyle}" Click="SystemSetting_Click">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xEDA2;" FontSize="20" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Storage" FontWeight="SemiBold" />
                                <TextBlock Text="Storage space and drive information" Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" />
                        </Grid>
                    </Button>
                </Border>
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Button Tag="About" Style="{StaticResource SettingsRowButtonStyle}" Click="SystemSetting_Click">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE946;" FontSize="20" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="About" FontWeight="SemiBold" />
                                <TextBlock Text="LAPTOP-IUCD4DSS · IdeaPad Slim 3 15ARP10 (mock data)" Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" />
                        </Grid>
                    </Button>
                </Border>
                <Button Content="Back to Home" HorizontalAlignment="Left" Margin="0,16,0,0" Click="BackToHome_Click" AutomationProperties.AutomationId="SystemBackHome" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
