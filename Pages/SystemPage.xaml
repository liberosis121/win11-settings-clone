<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="SettingsClone.Pages.SystemPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{StaticResource SettingsTextBrush}">
    <ScrollViewer x:Name="SystemScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <Grid Width="{Binding ViewportWidth, ElementName=SystemScrollViewer}">
            <StackPanel MaxWidth="1000" Margin="24,6,24,32" Spacing="8">
                <TextBlock Text="System" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,16" AutomationProperties.AutomationId="SystemHeading" />
                <TextBlock Text="Demo settings for HW1012. These controls do not change Windows settings." Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock x:Name="SystemDeviceText" Style="{StaticResource SecondaryTextStyle}" AutomationProperties.AutomationId="SystemDeviceText" />
                <TextBlock x:Name="SystemBluetoothText" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,16" AutomationProperties.AutomationId="SystemBluetoothText" />
                <ItemsControl x:Name="SettingsRows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,8">
                                <Button Tag="{Binding}" Style="{StaticResource SettingsRowButtonStyle}" Click="SystemSetting_Click" AutomationProperties.Name="{Binding Title}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{Binding Glyph}" FontSize="20" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" />
                                    </Grid>
                                </Button>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Back to Home" HorizontalAlignment="Left" Margin="0,8,0,0" Click="BackToHome_Click" AutomationProperties.AutomationId="SystemBackHome" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
